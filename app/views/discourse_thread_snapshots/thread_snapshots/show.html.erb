<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= @snapshot.title %></title>
    <% nonce = respond_to?(:content_security_policy_nonce) ? content_security_policy_nonce : nil %>
    <style<% if nonce.present? %> nonce="<%= nonce %>"<% end %>>
      body {
        margin: 0;
        color: #222;
        background: #fff;
        font: 16px/1.5 sans-serif;
      }
      main {
        max-width: 40rem;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
      }
      h1 {
        margin: 0 0 1.5rem;
        font-size: 1.5rem;
        line-height: 1.3;
      }
      .page-heading {
        margin: 0 0 0.35rem;
        color: #666;
        font-size: 0.95rem;
      }
      hr {
        margin: 2rem 0 0;
        border: 0;
        border-top: 1px solid #ddd;
      }
      .page-footer {
        margin-top: 1.25rem;
        color: #555;
        font-size: 0.85rem;
        text-align: left;
      }
      .page-footer p {
        margin: 0.35rem 0;
      }
      article {
        display: flex;
        gap: 0.75rem;
        padding: 1rem 0;
        border-top: 1px solid #ddd;
      }
      img {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        flex: 0 0 auto;
      }
      .meta {
        color: #444;
        font-size: 0.9rem;
      }
      .name {
        color: #222;
        font-weight: 600;
      }
      time {
        margin-left: 0.4rem;
      }
      .cooked {
        margin-top: 0.35rem;
      }
      .cooked img {
        width: auto;
        height: auto;
        max-width: 100%;
        border-radius: 0;
      }
    </style>
  </head>
  <body>
    <main>
      <% if @page_heading.present? %>
        <p class="page-heading"><%= @page_heading %></p>
      <% end %>
      <h1><%= @snapshot.title %></h1>
      <% @snapshot.frozen_posts.each do |post| %>
        <% name = post["name"].to_s.strip %>
        <% username = post["username"].to_s %>
        <% label = name.presence || username %>
        <article>
          <% if post["avatar_url"].present? %>
            <img src="<%= post["avatar_url"] %>" alt="<%= label %>">
          <% end %>
          <div>
            <div class="meta">
              <span class="name"><%= label %></span>
              <% if name.present? && username.present? && name != username %>
                <span class="username"><%= username %></span>
              <% end %>
              <% if post["created_at"].present? %>
                <time datetime="<%= post["created_at"] %>"><%= DiscourseThreadSnapshots::ThreadSnapshot.format_timestamp(post["created_at"]) %></time>
              <% end %>
            </div>
            <div class="cooked"><%= post["cooked"].to_s.html_safe %></div>
          </div>
        </article>
      <% end %>
      <% if @footer_html.present? %>
        <hr>
        <footer class="page-footer"><%= @footer_html.html_safe %></footer>
      <% end %>
    </main>
  </body>
</html>
